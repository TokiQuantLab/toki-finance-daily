# 仅 API 自动成稿模式需要；Agent 读取 Skill 可直接成稿。
# 把变量 export 到进程环境；程序不会自动读取 .env。
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# json_schema（默认）或 json_object，按服务商支持选择。
LLM_RESPONSE_FORMAT=json_schema

# 金十官方免费账户 MCP；没有 Token 时匿名普通版快讯仍可使用。
JIN10_MCP_TOKEN=
# 可选本机私有凭证文件，默认 ~/.config/toki-finance-daily/credentials.json。
TOKI_DAILY_CREDENTIALS_FILE=
